# 複製這個檔案到專案根目錄，改名為 .env，再填入實際值。
# .env 已在 .gitignore 內，不會被推上 GitHub；這份範本不要填真實密碼。

# ── 網頁（必填）──
# Flask session 簽章金鑰：固定一組隨機字串，換掉會讓所有人被登出。
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
KOUSHI_WEB_SECRET_KEY=
# 系辦登入密碼
KOUSHI_OFFICE_PASSWORD=
# 系統對外網址：委員專屬連結、信件裡的連結都用它組出來，必須是 https://
KOUSHI_PUBLIC_URL=https://

# ── 寄信／收信（必填，Gmail 需開啟兩步驟驗證並建立「應用程式密碼」）──
MAIL_SENDER=
MAIL_PASSWORD=
# 不是 Gmail 時才需要填 IMAP 主機（讀教授回信用）
MAIL_IMAP_HOST=

# ── 機構識別（正式環境必填）──
# 程式預設是匿名示範值（示範大學／示範學系），展示與錄影不會出現真實校系；
# 正式環境（KOUSHI_ENV=production）沒設定下面前四項會拒絕啟動。
# 下面各項請填入貴單位自己的校名與系名；註解裡的「國立範例大學／範例學系」只是虛構示例，
# 不要照抄（照抄會讓校內判定與口試費算錯）。這份範本刻意留白，未填時正式環境拒絕啟動。
# 畫面抬頭與附件6 清冊標題的校名、系名（例：國立範例大學、範例學系）
KOUSHI_UNIV_NAME=
# 附件6 交通費備註「<簡稱><->單位」的學校簡稱；未填時由校名去掉「國立」「大學」（例：範例）
KOUSHI_UNIV_SHORT_NAME=
KOUSHI_DEPT_NAME=
# 信件署名（「— 署名」）、頁面上的聯繫窗口、產出附件4／6 的文件作者欄；未填時為「<系名>系辦」（例：範例大學範例系辦）
KOUSHI_OFFICE_SIGNATURE=
# 校內判定（影響口試費與交通費）：委員服務單位含任一關鍵字即視為本系／本校，逗號分隔；
# 比對前會去掉空白與「國立」，所以要列出常見簡稱
# （例：KOUSHI_HOME_DEPT_KEYS=範例大學範例學系,範例大學範例系　KOUSHI_HOME_UNIV_KEYS=範例大學）
KOUSHI_HOME_DEPT_KEYS=
KOUSHI_HOME_UNIV_KEYS=
# 附件6 服務單位欄對本系委員的寫法；未填時為「本校<系名>」（例：本校範例學系）
KOUSHI_HOME_DEPT_LABEL=

# ── 選填 ──
# LibreOffice 不在預設安裝位置時，填 soffice.com 的完整路徑
KOUSHI_SOFFICE=
# 產出文件的範本字樣（預設照正式範本；示範／評審模式自動改中性寫法）。要改時取消註解：
# 附件4 標題右側的班別提醒（填空白＝移除）
# KOUSHI_ATT4_TITLE_NOTE=
# 附件6 說明列拿掉「依○年○月○日…委員會修正通過」的校內出處（1＝拿掉，0＝保留）
# KOUSHI_ATT6_NEUTRAL_NOTE=

# ── AI（選填；不填則所有 agent 轉人工，規則流程照常）──
# 擇一：Gemini（Google AI Studio 金鑰，走 OpenAI 相容端點），或 OpenAI；兩把都填時 Gemini 為主、OpenAI 當備援
GEMINI_API_KEY=
OPENAI_API_KEY=
# 兩把都填時改成 OpenAI 為主、Gemini 備援（決賽展示建議，延遲短、不需限速）：KOUSHI_LLM_PROVIDER=openai
# 或用本機模型（Ollama，不連外網、不需金鑰、資料不離開這台電腦）：KOUSHI_LLM_PROVIDER=ollama
# 覆寫模型名稱（預設 Gemini 用 gemini-3.5-flash-lite、OpenAI 用 gpt-4o-mini、Ollama 用 qwen2.5:3b）
KOUSHI_LLM_MODEL=
# Gemini 免費額度限速：連續呼叫至少間隔幾秒（預設 4；0＝不限速）
KOUSHI_LLM_MIN_INTERVAL=
# 運維緊急停止：設為 1 時停用所有模型呼叫與 agent 自動動作，畫面無法解除
KOUSHI_AI_DISABLED=
